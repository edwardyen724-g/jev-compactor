{
  "name": "jev-compactor-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:lib": "pnpm --filter jev-compactor build",
    "build": "pnpm -r build",
    "//": "bench's typecheck resolves jev-compactor through the workspace link to dist/, so the library is built first.",
    "typecheck": "pnpm build:lib && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:live": "pnpm -r --if-present test:live",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.0"
  }
}
