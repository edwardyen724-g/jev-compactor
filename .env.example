# TypeSafe AI (Jev) — required. Get a key at https://typesafe.ai
# Local dev: copy to .env.local (gitignored). The SDK reads this from the environment;
# the CLI, MCP server and tests also load .env.local from the repo root.
TYPESAFE_API_KEY=
# Optional SDK overrides (TYPESAFE_LOG_LEVEL is the SDK's own; jev-compactor pins its client to
# `warn`, because `debug` logs request bodies, so it is not honored there)
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn
